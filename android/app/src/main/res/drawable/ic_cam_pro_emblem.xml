    <path android:pathData="M36,29 A7,7 0 1,1 35.99,29 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="29"
                android:startY="29"
                android:endX="43"
                android:endY="43"
                android:startColor="#3D7EFF"
                android:endColor="#105BFF"
                android:type="linear" />
        </aapt:attr>
    </path>
    <!-- Tangerine Orange Optik Parlama & Canlı Kayıt Noktası -->
    <path
        android:fillColor="#FE8500"
        android:pathData="M45.5,24.5 A3.0,3.0 0 1,1 45.49,24.5 Z" />
