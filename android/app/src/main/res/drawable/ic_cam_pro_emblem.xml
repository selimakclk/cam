    android:viewportHeight="72">
    <!-- Dış yumuşak Royal Blue hale -->
    <path android:pathData="M36,4 A32,32 0 1,1 35.99,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="36"
                android:centerY="36"
                android:gradientRadius="32"
                android:startColor="#3A105BFF"
                android:endColor="#00105BFF"
                android:type="radial" />
        </aapt:attr>
    </path>
    <!-- Charcoal Black ana lens gövdesi -->
    <path
        android:fillColor="#181A24"
        android:strokeColor="#2EFFFFFF"
        android:strokeWidth="1.2"
        android:pathData="M36,10 A26,26 0 1,1 35.99,10 Z" />
