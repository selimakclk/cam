<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12141C">

    <!-- 1. KAMERA EKRANI (CAMERAX + PRO 3-KATMANLI AI + VİZÖR) -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <com.cam.ai.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ÜST DURUM & HEDEF HUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="38dp">

            <!-- Üst Bar (Charcoal Glass Capsule) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_capsule"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:background="@drawable/dot_active" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="AI Başlatılıyor..."
                    android:textColor="#F5F7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtIpBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:text="Şifre: •••••"
                    android:textColor="#9BA1B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hedef Kilidi Kapsülü (Dinamik Charcoal / Royal Blue / Tangerine) -->
            <LinearLayout
                android:id="@+id/targetBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_capsule"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp">

                <TextView
                    android:id="@+id/txtTargetStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kişiye dokunarak kilitleyin"
                    android:textColor="#F5F7FA"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEnrollTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_pill_orange"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="360°"
                    android:textAllCaps="false"
                    android:textColor="#FFA33B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNameTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_pill"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="İsim"
                    android:textAllCaps="false"
                    android:textColor="#F5F7FA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUnlock"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_danger"
                    android:minWidth="0dp"
                    android:paddingHorizontal="11dp"
                    android:text="Aç"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 360° Rehberli Kişi Tanıtım Kapsülü (Tangerine Accent) -->
            <LinearLayout
                android:id="@+id/enrollBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_capsule_orange"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtEnrollGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="360° Kayıt (1/3) • Kameraya Bakın"
                    android:textColor="#FFA33B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEnrollDone"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_pill"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Bitir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Anlık Uyarı Hapı (Tangerine Rim) -->
            <TextView
                android:id="@+id/txtWarningBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_capsule_orange"
                android:elevation="6dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Kişi seçilmedi — Bir insana dokunun"
                android:textColor="#FFA33B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ALT KONTROL DOCK (Charcoal Glass) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtCodeDisplay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Oda: 12345  •  IP: -"
                        android:textColor="#9BA1B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFpsDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_pill"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="AI Hazır"
                        android:textColor="#4D8AFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#1FFFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStealth"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="0.92"
                        android:background="@drawable/btn_secondary"
                        android:text="Karart"
                        android:textAllCaps="false"
                        android:textColor="#F5F7FA"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMemory"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1.06"
                        android:background="@drawable/btn_secondary"
                        android:text="Hafıza"
                        android:textAllCaps="false"
                        android:textColor="#4D8AFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTorch"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="0.76"
                        android:background="@drawable/btn_secondary"
                        android:text="Flaş"
                        android:textAllCaps="false"
                        android:textColor="#F5F7FA"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFlip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="0.76"
                        android:background="@drawable/btn_secondary"
                        android:text="Çevir"
                        android:textAllCaps="false"
                        android:textColor="#F5F7FA"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnBackMain"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="3dp"
                        android:layout_weight="0.76"
                        android:background="@drawable/btn_secondary"
                        android:text="Çıkış"
                        android:textAllCaps="false"
                        android:textColor="#FE8500"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 2. İZLEYİCİ EKRANI (CANLI YAYIN + SENKRON VİZÖR + UZAKTAN KONTROL) -->
    <FrameLayout
        android:id="@+id/viewerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0F16"
        android:visibility="gone">

        <ImageView
            android:id="@+id/viewerStream"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.cam.ai.OverlayView
            android:id="@+id/viewerOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- İzleyici Üst Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="38dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_capsule"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp">

                <View
                    android:id="@+id/viewerStatusDot"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:background="@drawable/dot_active" />

                <TextView
                    android:id="@+id/txtViewerStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Kamera Aranıyor..."
                    android:textColor="#F5F7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewerManualIp"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_pill"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="IP Gir"
                    android:textAllCaps="false"
                    android:textColor="#F5F7FA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewerDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:background="@drawable/btn_danger"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Ayrıl"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/viewerTargetBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_capsule"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp">

                <TextView
                    android:id="@+id/txtViewerTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kişiye dokunarak kilitleyin"
                    android:textColor="#F5F7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewerUnlock"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_danger"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Kilidi Aç"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- İzleyici Alt Uzaktan Kontroller -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="14dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="10dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewerTorch"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:text="Kameranın Flaşını Aç/Kapat"
                    android:textAllCaps="false"
                    android:textColor="#FFA33B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewerFlip"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:text="Kamerayı Çevir"
                    android:textAllCaps="false"
                    android:textColor="#F5F7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 3. ANA GİRİŞ MENÜSÜ (CHARCOAL BLACK · ROYAL BLUE · TANGERINE ORANGE) -->
    <LinearLayout
        android:id="@+id/roleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen_home"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_home"
            android:elevation="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="22dp">

            <!-- Özel AI Optik Lens Amblemi -->
            <ImageView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:contentDescription="CAM AI Pro"
                android:src="@drawable/ic_cam_pro_emblem" />

            <!-- Başlık + Tangerine PRO Rozeti -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.03"
                    android:text="CAM AI"
                    android:textColor="#F5F7FA"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_pill_orange"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:text="PRO"
                    android:textColor="#FE8500"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cihaz İçi 3-Katmanlı Yapay Zeka Güvenlik"
                android:textColor="#9BA1B8"
                android:textSize="12.5sp" />

            <!-- 3 Özellik Mikro Rozet Şeridi -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● OSNet 512-D"
                    android:textColor="#4D8AFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● Sessiz"
                    android:textColor="#9BA1B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● 0 Ping"
                    android:textColor="#FFA33B"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Şifre Alanı -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:letterSpacing="0.06"
                android:text="5 HANELİ BAĞLANTI ŞİFRESİ"
                android:textColor="#7D849E"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/input_field"
                android:gravity="center"
                android:hint="Örn: 12345"
                android:inputType="number"
                android:letterSpacing="0.30"
                android:maxLength="5"
                android:text="12345"
                android:textColor="#F5F7FA"
                android:textColorHint="#4A5066"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Hero Royal Blue Ana Eylem -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRoleCamera"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_primary"
                android:elevation="6dp"
                android:text="Kamera Ol  •  AI Başlat"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <!-- İkincil Charcoal Slate Eylem -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRoleViewer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:text="İzleyici Ol  •  Canlı Bağlan"
                android:textAllCaps="false"
                android:textColor="#F5F7FA"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="#1AFFFFFF" />

            <!-- Sürüm & Güncelleme Kontrol Hapı -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/btn_pill"
                android:text="Sürüm v3.1 • Güncellemeyi Kontrol Et"
                android:textAllCaps="false"
                android:textColor="#8CB4FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Gizli Mod PIN: 7693  •  Ekran Kapalı &amp; Çevrimdışı Çalışır"
                android:textColor="#686F88"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. GİZLİ MOD (SAF OLED SİYAH #000000 + CHARCOAL PRO PIN PAD) -->
    <FrameLayout
        android:id="@+id/stealthScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/stealthPinPanel"
            android:layout_width="304dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_home"
            android:elevation="14dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gizli Mod Kilidi"
                android:textColor="#F5F7FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPinDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="14dp"
                android:letterSpacing="0.32"
                android:text="○ ○ ○ ○"
                android:textColor="#4D8AFF"
                android:textSize="24sp" />

            <GridLayout
                android:id="@+id/pinKeypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:useDefaultMargins="true">

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin1" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="1" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin2" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="2" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin3" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="3" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin4" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="4" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin5" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="5" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin6" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="6" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin7" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="7" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin8" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="8" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin9" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="9" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pinCancel" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="Kapat" android:textAllCaps="false" android:textColor="#9BA1B8" android:textSize="13sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pin0" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="0" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pinDel" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:background="@drawable/btn_secondary" android:text="⌫" android:textColor="#FE8500" android:textSize="17sp" android:textStyle="bold" />
            </GridLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 5. ACİL ALARM PENCERESİ (CHARCOAL KART + TANGERINE ORANGE ÇERÇEVE) -->
    <LinearLayout
        android:id="@+id/alarmOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_alarm_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alarm_card"
            android:elevation="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="26dp"
            android:paddingVertical="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_pill_orange"
                android:letterSpacing="0.10"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="CANLI UYARI"
                android:textColor="#FE8500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="HEDEF KAYIP!"
                android:textColor="#F5F7FA"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="26dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Kilitlenen kişi kadrajdan ayrıldı.\nGeri döndüğünde yapay zeka otomatik yakalayacaktır."
                android:textColor="#9BA1B8"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDismissAlarm"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_accent_orange"
                android:elevation="6dp"
                android:text="Uyarıyı Kapat"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
